# URL base do backend do mem-words.
#
# Opcional: só é preciso definir para apontar para um backend diferente do
# padrão. Copie este arquivo para `.env` e ajuste conforme o seu ambiente.
#
# Sem esta variável, a aplicação usa os padrões embutidos em `src/config.js`:
#   desenvolvimento -> http://localhost:8080
#   produção        -> https://mem-words-backend.onrender.com
VITE_API_URL=http://localhost:8080

# Client ID OAuth 2.0 Web do Google Cloud Console, para o botão "Entrar com
# o Google" (Google Identity Services).
#
# Opcional: sem esta variável, o botão simplesmente não aparece — o resto da
# tela de entrada/cadastro continua funcionando normalmente.
#
# Precisa ser o MESMO Client ID configurado no backend (GOOGLE_CLIENT_ID) —
# valores diferentes fazem todo login com Google falhar.
VITE_GOOGLE_CLIENT_ID=
